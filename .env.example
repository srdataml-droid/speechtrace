# Set these only on the SERVER (Hugging Face Space secrets or local shell). Never commit real keys.
# Choose one speech provider; all are optional. No key required for manual transcript.
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# The OpenAI key is also used for text coaching if explicitly enabled by a visitor.
SPEECHTRACE_COACH_MODEL=gpt-4.1-mini
# Optional basic access control for a temporary Gradio demo
SPEECHTRACE_USER=
SPEECHTRACE_PASSWORD=
GRADIO_SHARE=0
# REST API: REQUIRED when published beyond loopback. Never commit a real secret.
SPEECHTRACE_API_TOKEN=
# Only retained if persist_report=true (user opt-in); raw audio is deleted after analysis.
SPEECHTRACE_REPORT_DB=
SPEECHTRACE_REPORT_TTL=3600
